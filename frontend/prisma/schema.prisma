generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model course {
  course_id       Int               @id @default(autoincrement())
  course_code     String            @unique @db.VarChar(20)
  course_name     String            @db.VarChar(100)
  credit_hours    Int
  semester        Int
  enrollment      enrollment[]
  lecturer_course lecturer_course[]
}

model enrollment {
  enrollment_id Int      @id @default(autoincrement())
  student_id    String?  @db.VarChar(15)
  course_id     Int?
  semester      Int?
  academic_year String?  @db.VarChar(20)
  course        course?  @relation(fields: [course_id], references: [course_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_course")
  student       student? @relation(fields: [student_id], references: [student_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_student")
}

model fee_payment {
  payment_id    Int       @id @default(autoincrement())
  student_id    String?   @db.VarChar(15)
  amount_paid   Decimal   @db.Decimal(10, 2)
  payment_date  DateTime? @db.Date
  semester      Int?
  academic_year String?   @db.VarChar(20)
  student       student?  @relation(fields: [student_id], references: [student_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_student")
}

model lecturer {
  lecturer_id     Int               @id @default(autoincrement())
  first_name      String?           @db.VarChar(50)
  last_name       String?           @db.VarChar(50)
  email           String?           @unique @db.VarChar(100)
  office          String?           @db.VarChar(50)
  lecturer_course lecturer_course[]
  lecturer_ta     lecturer_ta[]
}

model lecturer_course {
  assignment_id Int       @id @default(autoincrement())
  lecturer_id   Int?
  course_id     Int?
  course        course?   @relation(fields: [course_id], references: [course_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assignment_course")
  lecturer      lecturer? @relation(fields: [lecturer_id], references: [lecturer_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assignment_lecturer")
}

model lecturer_ta {
  assignment_id      Int                 @id @default(autoincrement())
  lecturer_id        Int?
  ta_id              Int?
  lecturer           lecturer?           @relation(fields: [lecturer_id], references: [lecturer_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lt_lecturer")
  teaching_assistant teaching_assistant? @relation(fields: [ta_id], references: [ta_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lt_ta")
}

model student {
  student_id  String        @id @db.VarChar(15)
  first_name  String        @db.VarChar(50)
  last_name   String        @db.VarChar(50)
  gender      String?       @db.VarChar(10)
  email       String?       @unique @db.VarChar(100)
  phone       String?       @db.VarChar(20)
  level       Int?
  programme   String?       @db.VarChar(100)
  total_fees  Decimal       @db.Decimal(10, 2)
  enrollment  enrollment[]
  fee_payment fee_payment[]
}

model teaching_assistant {
  ta_id       Int           @id @default(autoincrement())
  first_name  String?       @db.VarChar(50)
  last_name   String?       @db.VarChar(50)
  email       String?       @unique @db.VarChar(100)
  lecturer_ta lecturer_ta[]
}
